    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.550.0",
    "motion": "^13.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.3.3",
