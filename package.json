{
  "name": "solowrk",
  "version": "0.1.14",
  "private": true,
  "description": "Freelance business and project management, entirely on your own PC",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "npm run typecheck && node scripts/electron-vite.mjs build",
    "preview": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:win": "npm run build && electron-builder --win",
    "icon": "node scripts/make-icon.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
