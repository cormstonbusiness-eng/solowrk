    "electron-updater": "^6.8.9",
    "mammoth": "^1.12.1",
    "nodemailer": "^9.0.5",
    "pdfjs-dist": "^6.2.108",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.90.0",
